<div class="flex-parent">
    <div id="left-bg">
        <div id="left-box">
            <div id="left-container">
                <div id="left-first-display" >
                    <h1 class="rules-title" id="verify-text" style="">VERIFY YOURSELF FIRST!</h1>
                    <h4 id="username-title-text">Username</h4>
                    <div class="flex-parent" id="left-flex-parent2">
                        <div class="sec-ques">
                            <input type="text" placeholder="Username" name="username" id="verify-username" required>
                        </div>
                    </div>
                    <div class="flex-parent" id="left-flex-parent2">
                        <button id="verify-username-identity" type="submit" style="cursor:pointer">Submit</button>
                    </div>
                    <div class="flex-parent" id="left-flex-parent2">
                        <div id="verify-error" style="display: none;">
                            <p id="verify-error-msg">Invalid Username</p>
                        </div>
                    </div>
                </div>
                <div id="left-second-display" style="display: none;">
                    <h1 class="rules-title" id="password-rules">RULES FOR PASSWORD</h1>
                    <div class="flex-parent" id="left-flex-parent" id="rules">
                        <div class="pass-rules">
                            <div class="pass-rules-items">
                                <img class="checklist" id="forgot-rule-length" src="/img/invalid.png" width="20"/>
                                <p>Must be <b><mark>10 characters</mark></b> long</p>
                            </div>
                            
                            <div class="pass-rules-items">
                                <img class="checklist" id="forgot-rule-uppercase" src="/img/invalid.png" width="20"/>
                                <p>Must have at least <b><mark>one (1) UPPERCASE</mark></b> character</p>
                            </div>

                            <div class="pass-rules-items">
                                <img class="checklist" id="forgot-rule-lowercase" src="/img/invalid.png" width="20"/>
                                <p>Must have at least <b><mark>one (1) LOWERCASE</mark></b> character</p>
                            </div>

                            <div class="pass-rules-items">
                                <img class="checklist" id="forgot-rule-numerical" src="/img/invalid.png" width="20"/>
                                <p>Must have at least <b><mark>one (1) NUMERICAL</mark></b> character</p>
                            </div>

                            <div class="pass-rules-items">
                                <img class="checklist" id="forgot-rule-symbol" src="/img/invalid.png" width="20"/>
                                <p>Must have at least <b><mark>one (1) SYMBOL</mark></b> character</p>
                            </div>

                            <div class="pass-rules-items">
                                <img class="checklist" id="forgot-rule-name" src="/img/invalid.png" width="20"/>
                                <p>Must <b><mark>not include</mark></b> your <b><mark>NAME</mark></b> or <b><mark>USERNAME</mark></b></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="right-bg">
        <div id="right-box">
            <div id="right-container">
                <div id="right-first-display" style="display: none;">
                    <h1 id="sec-questions-title">Security Questions</h1>
                    <div class="questionnaires">
                        <h3 id="verify-question1" class="verify-questions">Placeholder</h3>
                        <input type="text" placeholder="Answer..." name="answer1" id="verify-answer1" required>
                        <br> <br>
                        <h3 id="verify-question2" class="verify-questions">Placeholder</h3>
                        <input type="text" placeholder="Answer..." name="answer2" id="verify-answer2" required>
                        <br>
                        <button id="verify-identity" type="submit" style="cursor:pointer">Verify</button>
                    </div>
                </div>

                <div id="right-second-display" style="display: none;">
                    <h1 id="new-password-title" >Input New Password</h1>
                    <div class="flex-parent" id="password-inputs">
                        <div class="container-inputs">
                            <input type="hidden" id="forgot-path" value="{{path}}">
                            <h4 class="pass-title-text" id="name-holder">New Password</h4>
                            <div class="eye-div" id="forgot-eye-div-pass" style="cursor:pointer">
                                <input id="forgot-pass" type="password" placeholder="********" name="pass" minlength="10" required>
                                <i class="fas fa-eye"></i>
                            </div>
                            <br>
                            <h4 class="pass-title-text">Retype New Password</h4>
                            <div class="eye-div" id="forgot-eye-div-retype" style="cursor:pointer">
                                <input id="forgot-retype-pass" type="password" placeholder="********" name="retype-pass" required>
                                <i class="fas fa-eye"></i>
                            </div>
                        </div>
                    </div>
                    <button id="change-pass-btn" type="submit" style="cursor:pointer">Change</button>
                </div>

                <div id="change-pass-error" >
                    <h1 id="change-pass-error-title">SORRY!</h1>
                    <div class="change-pass-error-paragraphs">
                        <h3 class="change-pass">You cannot change your password at the moment</h3>
                        <h3 class="change-pass">Try again later</h3>
                        <button id="go-back-btn" type="submit" style="cursor:pointer">Go Back</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{!-- error popup --}}
<div id="forgot-order-popup" style="display: none;">
    <h1 id="forgot-error-title">INVALID / MISSING INPUTS</h1>
    <input type="hidden" id="hidden-orderid">
    <table class="forgot-popup-table">
        <!--<tr class="popup-tr"></tr>-->
    </table>
    <button id="close-error-forgot-btn">OKAY</button>
</div>
{{!-- until here --}}

<script>
    const passwordField = document.getElementById("forgot-pass");
    const eyeSymbol = document.querySelector("#forgot-eye-div-pass i");
    eyeSymbol.addEventListener("click", function () {
    if (passwordField.type === "password") {
        passwordField.type = "text";
        eyeSymbol.classList.remove("fa-eye-slash");
        eyeSymbol.classList.add("fa-eye");
    } else {
        passwordField.type = "password";
        eyeSymbol.classList.remove("fa-eye");
        eyeSymbol.classList.add("fa-eye-slash");
    }
    });

    const retypeField = document.getElementById("forgot-retype-pass");
    const retypeEyeSymbol = document.querySelector("#forgot-eye-div-retype i");
    retypeEyeSymbol.addEventListener("click", function () {
    if (retypeField.type === "password") {
        retypeField.type = "text";
        retypeEyeSymbol.classList.remove("fa-eye-slash");
        retypeEyeSymbol.classList.add("fa-eye");
    } else {
        retypeField.type = "password";
        retypeEyeSymbol.classList.remove("fa-eye");
        retypeEyeSymbol.classList.add("fa-eye-slash");
    }
    });

    function showPop(){
        document.getElementById("popup").style.visibility = "visible";
    }
</script>