<div class="flex-parent">
    <div id="left-bg">
        <div id="left-box">
            <div id="left-container">
                <h1>RULES FOR PASSWORD</h1>
                <div class="flex-parent" id="left-flex-parent" id="rules">
                    <div class="pass-rules">
                        <div class="pass-rules-items">
                            <img class="checklist" id="rule-length" src="/img/invalid.png" width="20"/>
                            <p>Must be <b><mark>10 characters</mark></b> long</p>
                        </div>
                        
                        <div class="pass-rules-items">
                            <img class="checklist" id="rule-uppercase" src="/img/invalid.png" width="20"/>
                            <p>Must have at least <b><mark>one (1) UPPERCASE</mark></b> character</p>
                        </div>

                        <div class="pass-rules-items">
                            <img class="checklist" id="rule-lowercase" src="/img/invalid.png" width="20"/>
                            <p>Must have at least <b><mark>one (1) LOWERCASE</mark></b> character</p>
                        </div>

                        <div class="pass-rules-items">
                            <img class="checklist" id="rule-numerical" src="/img/invalid.png" width="20"/>
                            <p>Must have at least <b><mark>one (1) NUMERICAL</mark></b> character</p>
                        </div>

                        <div class="pass-rules-items">
                            <img class="checklist" id="rule-symbol" src="/img/invalid.png" width="20"/>
                            <p>Must have at least <b><mark>one (1) SYMBOL</mark></b> character</p>
                        </div>

                        <div class="pass-rules-items">
                            <img class="checklist" id="rule-name" src="/img/invalid.png" width="20"/>
                            <p>Must <b><mark>not include</mark></b> your <b><mark>NAME</mark></b> or <b><mark>USERNAME</mark></b></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="right-bg">
        <div id="right-box">
            <div id="right-container">
                <h1>Create Account</h1>
                <div class="flex-parent" id="right-flex-parent" id="inputs">
                    <div class="container-inputs">
                        <input type="text" placeholder="Username" name="username" id="username" required>
                        <br>
                        <input type="text" placeholder="First Name" name="firstname" id="firstname" required>
                        <br>
                        <input type="text" placeholder="Last Name" name="lastname" id="lastname" required>
                        <br>
                        <div class="eye-div" id="eye-div-pass" style="cursor:pointer">
                            <input id="pass" type="password" placeholder="********" name="pass" minlength="10" required>
                            <i class="fas fa-eye"></i>
                        </div>
                        <br>
                        <div class="eye-div" id="eye-div-retype" style="cursor:pointer">
                            <input id="retype-pass" type="password" placeholder="********" name="retype-pass" required>
                            <i class="fas fa-eye"></i>
                        </div>
                    </div>
                </div>
                <button id="create-account-btn" type="submit" style="cursor:pointer">Create</button>
            </div>
        </div>
    </div>
</div>

{{!-- error popup --}}
