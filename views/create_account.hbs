                            <option value="3">Childhood Nickname</option>
                            <option value="4">Name of the first school you attended</option>
                            <option value="5">Favorite subject in high school</option>
                        </select>
                        <input type="text" placeholder="Answer..." name="answer2" id="answer2" required>
                        <br> <br>
                        <select name="ques3" id="question3" >
                            <option value="">&#40Select Question&#41</option>
                            <option value="1">First Pet's Name</option>
                            <option value="2">Mother's maiden name</option>
                            <option value="3">Childhood Nickname</option>
                            <option value="4">Name of the first school you attended</option>
                            <option value="5">Favorite subject in high school</option>
                        </select>
                        <input type="text" placeholder="Answer..." name="answer3" id="answer3" required>
