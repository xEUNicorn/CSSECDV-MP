<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/error404.css">
</head>
<body>
    <div class="error-container">
        <div class="error-content">
            <div class="error-code">404</div>
            <div class="error-message">
                <h1>Page Not Found</h1>
                <p>Oops! The page you're looking for doesn't exist.</p>
                <p class="error-detail">It might have been moved or deleted.</p>
            </div>
            <div class="error-illustration">
                <svg width="300" height="300" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="150" cy="150" r="140" stroke="#720110" stroke-width="4" fill="none"/>
                    <path d="M100 120 Q150 80 200 120" stroke="#720110" stroke-width="6" stroke-linecap="round" fill="none"/>
                    <circle cx="110" cy="140" r="8" fill="#720110"/>
                    <circle cx="190" cy="140" r="8" fill="#720110"/>
                    <path d="M100 200 Q150 170 200 200" stroke="#720110" stroke-width="6" stroke-linecap="round" fill="none"/>
                </svg>
            </div>
            <div class="error-actions">
                <a href="/" class="btn btn-primary">Go to Homepage</a>
                <a href="/admin/login" class="btn btn-secondary">Go to Login</a>
            </div>
            <div class="error-help">
                <p>Need help? <a href="/contact_us">Contact Support</a></p>
            </div>
        </div>
    </div>
</body>
</html>
