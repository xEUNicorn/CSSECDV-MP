<div class="flex-parent">
    <div id="left-bg">
        <div id="left-box">
            <img id="logo" src="/img/ESMC_logo_big.svg" />
            <p>COPYRIGHT &copy; 2024 ALL RIGHTS RESERVED</p>
        </div>
    </div>
    <div id="right-bg">
        <div id="right-box">
            <div id="container">
                <h1>Welcome Back!</h1>
                <form action="/{{path}}/login" method="POST" id="login-form">
                    <div class="flex-parent" id="inputs">
                        <div>
                            <input type="text" placeholder="Username" name="username" required>
                            <br>
                            <input id="password" type="password" placeholder="********" name="password" required>
                        </div>
                        <div id="eye-div" style="cursor:pointer"><i class="fas fa-eye"></i></div>
                    </div>
                    <button type="submit" style="cursor:pointer">LOGIN</button>
                </form>
                <div class="forgot-container">
                    <h6><a id="create-account" href="/create_account?from={{path}}">Create Account</a></h6>
                    <!-- TODO: REROUTE TO ANOTHER ROUTE-->
                    <h6 id="forgot-password" onclick="showPop()">Forgot Password?</h6> 
                </div>
            </div>
        </div>
    </div>
</div>
<!-- forgot password TODO: CHANGE THE CONTENT AND REDIRECT TO ANOTHER ROUTE-->
<div id="popup" style="visibility:hidden;">
    <img id="question-mark" src="/img/question_mark.svg" />
    <h2>Please contact your hub manager for proper credentials</h2>
    <p id="popup-msg"><a id="login-link" href="/{{path}}/login">Back to Login</a></p>
</div>

<script>
    const passwordField = document.getElementById("password");
    const eyeSymbol = document.querySelector("#eye-div i");
    eyeSymbol.addEventListener("click", function () {
    if (passwordField.type === "password") {
        passwordField.type = "text";
        eyeSymbol.classList.remove("fa-eye-slash");
        eyeSymbol.classList.add("fa-eye");
    } else {
        passwordField.type = "password";
        eyeSymbol.classList.remove("fa-eye");
        eyeSymbol.classList.add("fa-eye-slash");
    }
    });

    function showPop(){
        document.getElementById("popup").style.visibility = "visible";
    }
</script>