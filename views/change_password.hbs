<script>
    try { document.body.classList.add('change-password-page'); } catch (e) { /* safe fallback for server rendering */ }
</script>

<div class="page-content">
    <div class="password-container">
        <div class="password-box">
        <h1>Change Password</h1>
        <p class="subtitle">Secure your account with a new password</p>

        <div id="reauth-section">
            <h3>Verify Your Identity</h3>
            <p class="info-text">For security purposes, please enter your current password to continue.</p>
            <form id="reauth-form">
                <div class="form-group">
                    <input type="password" id="verify-password" placeholder="Current Password" required>
                    <div class="eye-icon" onclick="togglePasswordVisibility('verify-password')">
                        <i class="fas fa-eye"></i>
                    </div>
                </div>
                <button type="submit" class="btn-primary">Verify</button>
            </form>
        </div>

        <div id="change-section" style="display: none;">
            <div class="eligibility-info" id="eligibility-info"></div>
            
            <form id="change-form">
                <div class="form-group">
                    <label>Current Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="current-password" name="currentPassword" placeholder="Enter current password" required>
                        <div class="eye-icon" onclick="togglePasswordVisibility('current-password')">
                            <i class="fas fa-eye"></i>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>New Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="new-password" name="newPassword" placeholder="Enter new password" minlength="10" required>
                        <div class="eye-icon" onclick="togglePasswordVisibility('new-password')">
                            <i class="fas fa-eye"></i>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Confirm New Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="confirm-password" name="confirmPassword" placeholder="Confirm new password" minlength="10" required>
                        <div class="eye-icon" onclick="togglePasswordVisibility('confirm-password')">
                            <i class="fas fa-eye"></i>
                        </div>
                    </div>
                </div>

                <div class="password-requirements">
                    <h4>Password Requirements:</h4>
                    <ul>
                        <li>Must be at least 10 characters long</li>
                        <li>Must not include name or username in password</li>
                        <li>Must be mix of uppercase, lowercase, numerical and symbol characters</li>
                        <li>Must be at least 1 day old before changing again</li>
                        <li>Cannot reuse previous passwords</li>
                        <li>Must match confirmation</li>
                    </ul>
                </div>

                <button type="submit" class="btn-primary">Change Password</button>
                <a href="/{{path}}" class="btn-secondary">Cancel</a>
                <input type="hidden" id="hidden-value-path" value="{{path}}">
            </form>
        </div>
    </div>
    </div>
</div>

<div id="message-popup" class="popup" style="display: none;">
    <div class="popup-content">
        <span class="popup-icon" id="popup-icon">✓</span>
        <h2 id="popup-title">Success</h2>
        <p id="popup-message"></p>
        <button onclick="closePopup()" class="btn-primary">OK</button>
    </div>
</div>

<script>
    function togglePasswordVisibility(fieldId) {
        const field = document.getElementById(fieldId);
        const icon = field.parentElement.querySelector('.eye-icon i');
        
        if (field.type === 'password') {
            field.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            field.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    function showPopup(title, message, isError = false) {
        const popup = document.getElementById('message-popup');
        const icon = document.getElementById('popup-icon');
        const titleEl = document.getElementById('popup-title');
        const messageEl = document.getElementById('popup-message');

        titleEl.textContent = title;
        messageEl.textContent = message;
        icon.textContent = isError ? '✗' : '✓';
        icon.style.color = isError ? '#dc3545' : '#28a745';
        
        popup.style.display = 'flex';
    }

    function closePopup() {
        document.getElementById('message-popup').style.display = 'none';
        if (!document.getElementById('popup-icon').style.color.includes('220')) {
            const path = document.getElementById("hidden-value-path").value;
            window.location.href = '/' + path;
        }
    }

    /*  Checks all of the characters passed if they are a mix of uppercase, lowercase, number and symbols characters
        param: password - string of characters to be checked
        param: length - length of string passed
        returns list of boolean [uppercase, lowercase, number, symbol, strErrors]
    */
    function mixCharactersChecker(password, length) {
        var ctr = 0;
        var upper = false;
        var lower = false;
        var num = false;
        var symbol = false;
        var strErrors = [];

        while (ctr < length) {
            var char = password[ctr]
            if (char === char.toUpperCase() && char !== char.toLowerCase() && !upper) { //checks if uppercase character
                upper = true;
                strErrors.push("uppercase");
            }
            if (char !== char.toUpperCase() && char === char.toLowerCase() && !lower) { //checks if lowercase character
                lower = true;
                strErrors.push("lowercase");
            }
            if ($.isNumeric(char) && !num) { //checks if numerical character
                num = true;
                strErrors.push("numerical");
            }
            if (/^[a-zA-Z0-9 ]*$/.test(char) == false && !symbol) { //checks if symbol character (space is not included)
                symbol = true;
                strErrors.push("symbol");
            }
            ctr++;
        }
        strErrors = strErrors.join(", ")

        return [upper, lower, num, symbol, strErrors]
    }

    /*  Checks password contains their names/username, specifically if at least 4 characters are in there
        param: password - password to be checked if name or username is within it
        returns true if it is VALID; otherwise, false
    */
    function nameInPassword(password) {
        const user = document.getElementById('confirm-password').dataset.secret.toLowerCase();
        const firstLast = document.getElementById('verify-password').dataset.secret.toLowerCase();
        const pass = password.toLowerCase();

        const first = firstLast.split(' ')[0]
        const last = firstLast.split(' ')[1]

        if (!(first && last)) {
            return true;
        }

        const user4 = user.slice(0,4);
        const first4 = first.slice(0,4);
        const last4 = last.slice(0,4);

        var checker = false;

        if ((user && pass.includes(user4)) || (user && pass.includes(user)) ||
            (first && pass.includes(first4)) || (first && pass.includes(first)) ||
            (last && pass.includes(last4)) || (last && pass.includes(last))) {
                checker = true;
        }
        
        return checker
    }

    // Check eligibility on page load
    async function checkEligibility() {
        try {
            const response = await fetch('/password/can-change');
            const data = await response.json();
            
            const infoDiv = document.getElementById('eligibility-info');
            if (data.canChange) {
                infoDiv.innerHTML = '<p class="success-msg">✓ You can change your password</p>';
                infoDiv.className = 'eligibility-info success';
            } else {
                infoDiv.innerHTML = `<p class="warning-msg">⚠ ${data.message}</p><p>Last changed: ${data.lastChanged || 'Never'}</p>`;
                infoDiv.className = 'eligibility-info warning';
            }
        } catch (error) {
            console.error('Error checking eligibility:', error);
        }
    }

    // Re-authentication form
    document.getElementById('reauth-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const password = document.getElementById('verify-password').value;

        try {
            const response = await fetch('/password/verify-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password })
            });

            const data = await response.json();

            if (response.ok && data.success) {
                document.getElementById('reauth-section').style.display = 'none';
                document.getElementById('change-section').style.display = 'block';
                document.getElementById('verify-password').dataset.secret = data.name;
                document.getElementById('confirm-password').dataset.secret = data.username;
                await checkEligibility();
            } else {
                showPopup('Error', data.error || 'Invalid password', true);
            }
        } catch (error) {
            console.error('Verification error:', error);
            showPopup('Error', 'An error occurred. Please try again.', true);
        }
    });

    // Change password form
    document.getElementById('change-form').addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(e.target);
        const data = {
            currentPassword: formData.get('currentPassword'),
            newPassword: formData.get('newPassword'),
            confirmPassword: formData.get('confirmPassword')
        };
        var mixChecker = mixCharactersChecker(data.newPassword, data.newPassword.length)

        if (data.newPassword.length < 10) {
            showPopup('Error', 'Password is too short', true);
            return;
        } else if (!(mixChecker[0] && mixChecker[1] && mixChecker[2] && mixChecker[3])) {
            showPopup('Error', 'Password needs at least 1 ' + mixChecker[4] + ' character', true);
            return;
        } else if (nameInPassword(data.newPassword)) {
            showPopup('Error', 'Password must not include name or username', true);
            return;
        }


        if (data.newPassword !== data.confirmPassword) {
            showPopup('Error', 'New passwords do not match', true);
            return;
        }

        try {
            const response = await fetch('/password/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (response.ok && result.success) {
                showPopup('Success', 'Password changed successfully!');
            } else {
                showPopup('Error', result.error || 'Failed to change password', true);
            }
        } catch (error) {
            console.error('Password change error:', error);
            showPopup('Error', 'An error occurred. Please try again.', true);
        }
    });
</script>
